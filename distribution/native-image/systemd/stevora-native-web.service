[Unit]
Description=STEVORA OS Native Preview HTTP bootstrap (static files only)
Documentation=https://github.com/stefan1318/stevora-home-assistant-apps
After=network.target
ConditionPathExists=/usr/share/stevora-os/index.html

[Service]
Type=simple
ExecStart=/usr/sbin/httpd -f -p 80 -h /usr/share/stevora-os
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=yes

[Install]
WantedBy=multi-user.target
