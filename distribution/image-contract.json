  "product_structure": {
    "ecosystem_products": [
      "STEVORA OS",
      "STEVORA App for Android",
      "STEVORA App for iOS"
    ],
    "canonical_policy": "STEVORA_ECOSYSTEM_POLICY.md",
    "os_is_source_of_truth": true,
    "os_integrated_components": [
      "Stevora Core",
      "Stevora Universal Integration",
      "Stevora Home Panel 7.1.1 Premium",
      "Stevora Home Hub",
      "Stevora Frontend",
      "Stevora People & Presence",
      "Stevora Manifest"
