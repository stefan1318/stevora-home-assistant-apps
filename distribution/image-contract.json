    "subsystem_product_status": "internal-os-only",
    "mobile_architecture": "native-clients-of-stevora-os",
    "shared_contract": "authenticated-versioned-stevora-os-api",
    "hey_stevora": {
      "product_status": "built-in-os-and-mobile-feature",
      "providers": "configured-installed-voice-or-ai-assistants",
      "entitlement": "customer-choice-and-purchased-package",
      "unavailable_behavior": "explicit-not-available-no-fake-capabilities"
