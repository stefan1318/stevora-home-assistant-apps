      "required": true
    },
    {
      "id": "rpi5_64",
      "platform": "raspberry-pi-5-64",
      "required": true
    }
  ],
  "required_capabilities": [
    "home",
    "rooms",
    "devices",
    "climate",
    "lighting",
    "scenes",
    "automations-edit",
    "integrations-configure",
    "apps-install-manage",
    "users-permissions",
    "settings-network-storage",
    "system-health",
    "backups-restore",
    "core-supervisor-os-updates",
    "logs",
    "onboarding",
    "recovery"
  ],
  "verified_release_gates": {
    "native_root_frontend": false,
    "core_auth_permissions_verified": false,
    "integrations_and_apps_management_verified": false,
    "system_bridge_authorization_verified": false,
    "own_image_contains_frontend_and_boots": false,
    "ova_boot_and_recovery_verified": false,
    "rpi4_64_boot_verified": false,
    "rpi5_64_boot_verified": false,
    "signed_ota_and_rollback_verified": false,
    "licenses_and_trademarks_reviewed": false,
    "os_subsystems_integrated_and_permission_tested": false,
    "mobile_clients_use_os_contract": false,
    "hey_stevora_provider_and_entitlement_contract_tested": false,
    "personal_memory_not_bundled_in_public_image": false
  },
  "artifacts": {
    "bootable_image": null,
    "ota_bundle": null,
    "frontend_package": null,
    "system_bridge": null
